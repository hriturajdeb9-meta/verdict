# Copy to .env. Leave everything empty to run fully offline (simulated PayPal, heuristic arbiter).

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AI arbiter: set ONE of these. Gemini has a free tier (aistudio.google.com > Get API key).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional
# DEMO_FREELANCER_EMAIL=   (sandbox personal account pre-filled in the sample brief)
# PLATFORM_FEE_PERCENT=0
# MAX_REVIEW_ATTEMPTS=3
# GITHUB_TOKEN=
# PORT=3000
